@model GambaNet_Web.Application.ViewModel.GameViewModel

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">GambaNet</h1>
    <p>Vítejte na stránkách přední konkurence Synotipu a dalších podvodných webů.</p>
    <p><b>Pouze u nás</b> najdete skutečné výherní hazardní hry! Pojďte si zahrát, určitě vyhrajete mnoho peněz.</p>
    <br /><br />
    <div class="container text-start">
        <div class="row align-items-end">
            <div class="col">
                Nabídka dostupných akcí
                <ul>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Games" asp-action="Index">Hry</a>
                        <ul>
                            @if (Model.Games != null && Model.Games.Count > 0)
                            {
                                foreach (var game in Model.Games)
                                {
                                    <li>
                                        <a class="nav-link" asp-area="" asp-controller="Games" asp-action="@game.Name">@game.Name</a>
                                    </li>
                                }
                            }
                        </ul>
                    </li>
                    <li>
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Soukromí</a>
                    </li>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li>
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Info">Uživatelské centrum</a>
                        </li>
                    }
                </ul>
            </div>

            <div class="col">
                @await Component.InvokeAsync("RandomAd")
            </div>
        </div>
    </div>
</div>

@{
    /*
    @section Styles
        {
        <link rel="stylesheet" href="~/css/shop_home.css" asp-append-version="true" />
    }
    */
}
