@model IList<Game>

@{
        ViewData["Title"] = "Administrace her";
}

<h1>@ViewData["Title"]</h1>

<a asp-action="Create">Vytvořit hru</a>

@{
        if (Model != null && Model.Count > 0)
        {
                <table class="table">
                        <thead>
                        <tr>
                                <th scope="col">@nameof(Game.Id)</th>
                                <th scope="col">Jméno</th>
                                <th scope="col">Popis</th>
                                <th scope="col">Smazat</th>
                                </tr>
                        </thead>
                        <tbody>

                @foreach (var g in Model)
                {
                    <tr>
                        <th scope="row">@g.Id</th>
                        <td>@g.Name</td>
                        <td>@g.Description</td>
                        <td><a asp-action="Edit" asp-route-id="@g.Id" class="btn btn-primary">Editovat</a></td>
                        <td><a asp-action="Delete" asp-route-id="@g.Id" class="btn btn-danger" onclick="return ConfirmDelete();">Smazat</a></td>
                    </tr>
                }
                </tbody>
                </table>
        }
        else
        {
                <p>Žádné hry neexistují</p>
        }
}