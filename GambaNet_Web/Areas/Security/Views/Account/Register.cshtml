@model GambaNet_Web.Application.ViewModel.RegisterViewModel
@{
    ViewData["Title"] = "Registrace";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/login.css" />
}

<div id="logreg-forms">
    <form asp-action="Register" method="post" class="form-signup">
        <br />
        <h1 class="h3 mb-3 font-weight-normal" style="text-align: center">Registrace uživatele</h1>
        <div asp-validation-summary="All" class="text-danger"></div>
        <br />
        <input asp-for="Username" type="text" id="user-name" class="form-control" placeholder="Uživatelské jméno" autofocus="">
        <span asp-validation-for="Username" class="text-danger"></span>
        <br />
        <input asp-for="FirstName" type="text" id="first-name" class="form-control" placeholder="First name" autofocus="">
        <span asp-validation-for="FirstName" class="text-danger"></span>
        <br />
        <input asp-for="LastName" type="text" id="last-name" class="form-control" placeholder="Last name" autofocus="">
        <span asp-validation-for="LastName" class="text-danger"></span>
        <br />
        <input asp-for="Email" type="email" id="user-email" class="form-control" placeholder="E-Mailová adresa" autofocus="">
        <span asp-validation-for="Email" class="text-danger"></span>
        <br />
        <input asp-for="Phone" type="tel" id="user-phone" class="form-control" placeholder="Telefon" autofocus="">
        <span asp-validation-for="Phone" class="text-danger"></span>
        <br />
        <input asp-for="Password" type="password" id="user-pass" class="form-control" placeholder="Heslo" autofocus="">
        <span asp-validation-for="Password" class="text-danger"></span>
        <br />
        <input asp-for="RepeatedPassword" type="password" id="user-repeatpass" class="form-control" placeholder="Heslo znovu" autofocus="">
        <span asp-validation-for="RepeatedPassword" class="text-danger"></span>
        <br />
        <div class="text-center">
            <button class="btn btn-primary btn-block" type="submit">Registrovat</button>
        </div>
    </form>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}