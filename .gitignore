# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/GambaNet_Game/[Ll]ibrary/
/GambaNet_Game/[Tt]emp/
/GambaNet_Game/[Oo]bj/
/GambaNet_Game/[Bb]uild/
/GambaNet_Game/[Bb]uilds/
/GambaNet_Game/[Ll]ogs/
/GambaNet_Game/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/GambaNet_Game/[Mm]emoryCaptures/

# Recordings can get excessive in size
/GambaNet_Game/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/GambaNet_Game/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
/GambaNet_Game/.vs/

# Gradle cache directory
/GambaNet_Game/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
/GambaNet_Game/ExportedObj/
/GambaNet_Game/.consulo/
/GambaNet_Game/*.csproj
/GambaNet_Game/*.unityproj
/GambaNet_Game/*.sln
/GambaNet_Game/*.suo
/GambaNet_Game/*.tmp
/GambaNet_Game/*.user
/GambaNet_Game/*.userprefs
/GambaNet_Game/*.pidb
/GambaNet_Game/*.booproj
/GambaNet_Game/*.svd
/GambaNet_Game/*.pdb
/GambaNet_Game/*.mdb
/GambaNet_Game/*.opendb
/GambaNet_Game/*.VC.db

# Unity3D generated meta files
/GambaNet_Game/*.pidb.meta
/GambaNet_Game/*.pdb.meta
/GambaNet_Game/*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
/GambaNet_Game/*.apk
/GambaNet_Game/*.aab
/GambaNet_Game/*.unitypackage
/GambaNet_Game/*.app

# Crashlytics generated file
/GambaNet_Game/crashlytics-build.properties

# Packed Addressables
/GambaNet_Game/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/GambaNet_Game/[Aa]ssets/[Ss]treamingAssets/aa.meta
/GambaNet_Game/[Aa]ssets/[Ss]treamingAssets/aa/*
