<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GambaNet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GambaNet_Web.styles.css" asp-append-version="true" />
    <!-- @await RenderSectionAsync("Styles", required: false) -->
</head>
<body class="">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Gamba<span style="color:#56a4e3;">Net</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Games" asp-action="Index">Hry</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Soukromí</a>
                        </li>
                        @if (User.Identity.IsAuthenticated && (User.IsInRole(nameof(Roles.Admin)) || User.IsInRole(nameof(Roles.Default))))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Info">Uživatelské centrum</a>
                            </li>
                        }
                        @if (User.Identity.IsAuthenticated && User.IsInRole(nameof(Roles.Admin)))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="AdminGames" asp-action="Select">Úprava her</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Ad" asp-action="Index">Úprava Reklam</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="ImageUpload" asp-action="Index">Nahrávání obrázků</a>
                            </li>
                        }
                    </ul>
                    @{

                        if (User.Identity is { IsAuthenticated: false })
                        {
                            <span class="navbar-dark">
                                <span class="navbar-nav">
                                    <span class="nav-item">
                                        <a class="nav-link" asp-area="" asp-controller="Leaderboard" asp-action="Index">Síň slávy</a>
                                    </span>
                                    <span class="nav-item">
                                        <a class="nav-link" asp-area="Security" asp-controller="Account" asp-action="Login">Přihlásit</a>
                                    </span>
                                    <span class="nav-item">
                                        <a class="nav-link" asp-area="Security" asp-controller="Account" asp-action="Register">Registrovat</a>
                                    </span>
                                </span>
                            </span>
                        }
                        else
                        {
                            <span class="navbar-dark">
                                <span class="navbar-nav">
                                    <span class="nav-item">
                                        <a class="nav-link" asp-area="" asp-controller="Leaderboard" asp-action="Index">Síň slávy</a>
                                    </span>
                                    <span class="nav-item">
                                        <a class="nav-link" asp-area="Security" asp-controller="Account" asp-action="Logout">Odhlásit se (@User.Identity.Name)</a>
                                    </span>
                                </span>
                            </span>
                        }
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-dark">
        <div class="container text-light">
            <p>&copy;2025 Lukáš Urban & Jakub Kramný.&nbsp;<a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-danger">Prohlášení o ochraně osobních údajů</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="text-muted">Stav podpory - nedostupná</span>

                <span style="position:absolute; right:20px;font-size:10px ">
                    @{
                        Random random = new Random();
                        string message = random.Next(0, 13) switch
                        {
                            0 => "90 % gamblerů přestane hrát těsně před jejich další výhrou, nepřestávej!",
                            1 => "Štěstí přeje odvážným! Pokračuj!",
                            2 => "Každý pokus tě přibližuje k výhře, nevzdávej to!",
                            3 => "Kdo se nevzdá, vyhraje!",
                            4 => "Nezapomeň, že jen lůzři prohrávájí - ale to ty nejsi, takže to nevzdávej!",
                            5 => "Kdo hraje, ten nezlobí!",
                            6 => "Rozdáváme peníze zdarma!",
                            7 => "Bez gamby nejsou koláče!",
                            8 => "Odvážným štěstí přeje!",
                            9 => "Není to tak moc o tom, co prohraješ - je to o tom co vyhraješ!",
                            10 => "Ty texty co tu vyskakujou nemají s psychologickou manipulací nic společného, to říkají slabí doktoři co nikdy nevyhráli pořádnou sumu!",
                            11 => "Neznám nikoho, kdo by neměl rád peníze zdarma!",
                            12 => "Rozlučte se s živořením!"
                        };
                    }
                    @message
                </span>
                
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
